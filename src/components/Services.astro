---
import Icon from "./Icon.astro";
import { practiceAreas } from "../data/site";
---

<section id="services" class="bg-cream py-20 md:py-28">
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-xs font-bold uppercase tracking-[0.14em] text-gold">
        Areas of law
      </p>
      <h2
        class="mt-3 font-display text-4xl font-semibold tracking-tight text-navy md:text-5xl"
      >
        Legal support across Victoria
      </h2>
      <p class="mt-4 text-base leading-relaxed text-slate md:text-lg">
        Practical advice from our Brunswick practice — for individuals, families
        and businesses under Australian and Victorian law.
      </p>
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        practiceAreas.map((area) => (
          <a
            href={`/services/${area.slug}`}
            class="group flex flex-col overflow-hidden border border-navy/10 bg-white no-underline transition-colors hover:border-gold"
          >
            <div class="aspect-[16/10] overflow-hidden">
              <img
                src={area.image}
                alt={`${area.title} — Makdesi Lawyers`}
                class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
                width="800"
                height="500"
                loading="lazy"
              />
            </div>
            <div class="flex flex-1 flex-col p-6">
              <span class="flex h-11 w-11 items-center justify-center border border-gold text-gold">
                <Icon name={area.icon} class="h-5 w-5" />
              </span>
              <h3 class="mt-5 font-display text-2xl font-semibold text-navy group-hover:text-gold-deep">
                {area.title}
              </h3>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-slate">
                {area.description}
              </p>
              <span class="mt-5 inline-flex items-center gap-1.5 text-[0.72rem] font-bold uppercase tracking-[0.12em] text-gold">
                Learn more
                <span aria-hidden="true">→</span>
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
