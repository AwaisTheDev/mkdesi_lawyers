---
import { featuredAreas } from "../data/site";
---

<section id="services" class="bg-cream py-20 md:py-28">
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2
        class="font-display text-4xl font-semibold tracking-tight text-navy md:text-5xl"
      >
        Our Areas of Law
      </h2>
      <p class="mt-4 text-base leading-relaxed text-slate md:text-lg">
        Practical legal support across the matters that shape your life and
        business — from first advice through to resolution.
      </p>
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        featuredAreas.map((area) => (
          <article class="group flex flex-col bg-white">
            <div class="aspect-[4/3] overflow-hidden">
              <img
                src={area.image}
                alt=""
                class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
                width="800"
                height="600"
                loading="lazy"
              />
            </div>
            <div class="flex flex-1 flex-col p-5 md:p-6">
              <h3 class="font-display text-xl font-semibold text-navy">
                {area.title}
              </h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-slate">
                {area.description}
              </p>
              <a
                href={area.href}
                class="mt-5 inline-flex items-center gap-1.5 text-[0.72rem] font-bold uppercase tracking-[0.12em] text-gold no-underline transition-colors hover:text-gold-deep"
              >
                Learn more
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>

    <div class="mt-12 text-center">
      <a href="/services" class="btn-gold">View all areas of law</a>
    </div>
  </div>
</section>
