---
interface Props {
  class?: string;
  /** on-light = dark logo for white backgrounds; on-dark = white logo */
  variant?: "on-dark" | "on-light";
}

const {
  class: className = "h-11 w-auto sm:h-12",
  variant = "on-dark",
} = Astro.props;
---

<img
  src="/logo.png"
  alt="Makdesi And Associates Lawyers"
  class:list={[
    "block max-w-none object-contain",
    variant === "on-light" && "brightness-0",
    className,
  ]}
  width="487"
  height="108"
/>
