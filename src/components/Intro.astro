---
import { about, site } from "../data/site";
---

<section id="about" class="bg-white py-20 md:py-28">
  <div class="mx-auto grid max-w-7xl items-center gap-12 px-5 md:grid-cols-12 md:gap-16 md:px-8">
    <div class="md:col-span-6">
      <p class="text-xs font-bold uppercase tracking-[0.14em] text-gold">
        About the firm
      </p>
      <h2 class="mt-3 font-display text-4xl font-semibold tracking-tight text-navy md:text-5xl">
        {about.headline}
      </h2>
      <p class="mt-6 text-base leading-relaxed text-slate md:text-lg">
        {about.intro}
      </p>
      <p class="mt-5 text-base leading-relaxed text-slate md:text-lg">
        {about.paragraphs[0]}
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href="/about" class="btn-gold">About the firm</a>
        <a href="/contact" class="btn-outline-dark">Make an enquiry</a>
      </div>
    </div>

    <div class="md:col-span-6">
      <div class="overflow-hidden border border-navy/10">
        <img
          src="/images/reception-welcome.webp"
          alt={`${site.name} office`}
          class="aspect-[4/3] w-full object-cover"
          width="1000"
          height="750"
          loading="lazy"
        />
      </div>
    </div>
  </div>
</section>
