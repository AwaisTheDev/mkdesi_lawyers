---
import { values } from "../data/site";
---

<section id="why-us" class="relative overflow-hidden bg-ink py-24 text-white md:py-32">
  <div
    class="pointer-events-none absolute inset-0 opacity-40"
    style="background: radial-gradient(ellipse 60% 50% at 80% 20%, rgba(196,163,90,0.18), transparent);"
  >
  </div>
  <div class="relative mx-auto grid max-w-7xl gap-14 px-5 md:grid-cols-12 md:items-center md:px-8">
    <div class="md:col-span-5">
      <p class="section-label !text-gold reveal">Why choose us</p>
      <h2
        class="reveal reveal-delay-1 mt-5 font-display text-4xl leading-tight font-semibold tracking-tight md:text-5xl"
      >
        Legal support that feels personal
      </h2>
      <p class="reveal reveal-delay-2 mt-5 max-w-md text-lg leading-relaxed text-white/65">
        As you experience life’s changes, we’ll be there when you need advice —
        exploring every avenue to give you the best chance for a strong outcome.
      </p>
      <div class="reveal reveal-delay-3 mt-10 hidden overflow-hidden md:block">
        <img
          src="/images/team-collab.webp"
          alt="Makdesi lawyers collaborating in the Brunswick office"
          class="aspect-[4/3] w-full object-cover"
          width="2000"
          height="1400"
          loading="lazy"
        />
      </div>
    </div>
    <div class="grid gap-8 sm:grid-cols-2 md:col-span-7">
      {
        values.map((item, i) => (
          <article
            class:list={[
              "reveal border-t border-white/15 pt-6",
              i % 2 === 0 ? "reveal-delay-1" : "reveal-delay-2",
            ]}
          >
            <h3 class="font-display text-xl font-semibold tracking-tight">
              {item.title}
            </h3>
            <p class="mt-3 text-[0.95rem] leading-relaxed text-white/60">
              {item.description}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
