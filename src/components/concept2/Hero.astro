---
---

<section class="c2-hero" id="top">
  <div class="c2-hero-media" aria-hidden="true">
    <img
      src="/images/consultation.webp"
      alt=""
      width="2000"
      height="1400"
      fetchpriority="high"
    />
    <div class="c2-hero-shade"></div>
  </div>

  <div class="c2-wrap c2-hero-content">
    <a href="#services" class="c2-chip">
      Practice areas across commercial, family & more
      <span aria-hidden="true">→</span>
    </a>

    <p class="c2-hero-lead">
      We partner with clients across Brunswick and Melbourne to navigate life’s
      legal matters — from estate planning and property to criminal and family
      law — with clear advice and cost-effective results.
    </p>

    <a href="#contact" class="c2-btn">
      Contact Us
      <span aria-hidden="true">↗</span>
    </a>

    <h1 class="c2-display c2-hero-title">
      <span>Clear Guidance.</span>
      <span class="is-soft">Strong Representation.</span>
    </h1>
  </div>
</section>

<style>
  .c2-hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: var(--c2-navy);
  }
  .c2-hero-media {
    position: absolute;
    inset: 0;
  }
  .c2-hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 68% center;
  }
  .c2-hero-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(2, 22, 43, 0.96) 0%, rgba(2, 22, 43, 0.78) 42%, rgba(2, 22, 43, 0.25) 72%, rgba(2, 22, 43, 0.45) 100%),
      linear-gradient(180deg, rgba(2, 22, 43, 0.35) 0%, transparent 28%, rgba(2, 22, 43, 0.75) 100%);
  }
  .c2-hero-content {
    position: relative;
    z-index: 1;
    padding: 8.5rem 0 3.5rem;
    display: grid;
    gap: 1.5rem;
    max-width: 40rem;
    margin-left: max(1.25rem, calc((100% - 1180px) / 2));
    margin-right: auto;
    width: min(40rem, calc(100% - 2.5rem));
  }
  .c2-hero-lead {
    margin: 0;
    max-width: 34rem;
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.78);
  }
  .c2-hero-title {
    margin: 3.5rem 0 0;
    font-size: clamp(2.8rem, 8vw, 5.4rem);
    line-height: 0.98;
    font-weight: 550;
    letter-spacing: -0.03em;
  }
  .c2-hero-title span {
    display: block;
  }
  .c2-hero-title .is-soft {
    color: rgba(255, 255, 255, 0.55);
  }
  @media (min-width: 900px) {
    .c2-hero-content {
      padding-bottom: 4.5rem;
    }
    .c2-hero-title {
      margin-top: 5rem;
    }
  }
</style>
