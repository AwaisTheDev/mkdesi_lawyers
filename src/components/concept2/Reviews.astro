---
import { reviews } from "../../data/site";
---

<section class="c2-reviews" id="reviews">
  <div class="c2-wrap">
    <div class="c2-reviews-head">
      <p class="c2-label c2-reveal">Client success</p>
      <h2 class="c2-display c2-reviews-title c2-reveal c2-d1">
        Voices of confidence<br />in difficult times
      </h2>
    </div>

    <div class="c2-reviews-slider" data-c2-reviews>
      <div class="c2-reviews-track" data-c2-track>
        {
          reviews.map((review) => (
            <blockquote class="c2-review">
              <p>“{review.quote}”</p>
              <footer>
                <cite>{review.name}</cite>
                <span>Client</span>
              </footer>
            </blockquote>
          ))
        }
      </div>
      <div class="c2-reviews-nav">
        <button type="button" data-c2-prev aria-label="Previous review">←</button>
        <button type="button" data-c2-next aria-label="Next review">→</button>
      </div>
    </div>
  </div>
</section>

<style>
  .c2-reviews {
    background: var(--c2-navy-soft);
    padding: 5.5rem 0;
  }
  .c2-reviews-head {
    max-width: 40rem;
    margin-bottom: 2.5rem;
  }
  .c2-reviews-title {
    margin: 1rem 0 0;
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    line-height: 1.05;
    font-weight: 550;
    letter-spacing: -0.03em;
  }
  .c2-reviews-track {
    display: flex;
    transition: transform 0.7s var(--c2-ease);
  }
  .c2-review {
    flex: 0 0 100%;
    margin: 0;
    padding: 0;
  }
  .c2-review p {
    margin: 0;
    max-width: 48rem;
    font-family: "Fraunces", Georgia, serif;
    font-size: clamp(1.25rem, 2.4vw, 1.85rem);
    line-height: 1.35;
    font-weight: 500;
  }
  .c2-review footer {
    margin-top: 1.75rem;
  }
  .c2-review cite {
    display: block;
    font-style: normal;
    font-weight: 700;
    color: var(--c2-gold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: 0.78rem;
  }
  .c2-review span {
    display: block;
    margin-top: 0.25rem;
    color: var(--c2-muted);
    font-size: 0.85rem;
  }
  .c2-reviews-nav {
    display: flex;
    gap: 0.55rem;
    margin-top: 2rem;
  }
  .c2-reviews-nav button {
    width: 2.8rem;
    height: 2.8rem;
    border-radius: 0.55rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: transparent;
    color: #fff;
    cursor: pointer;
    font-size: 1rem;
  }
  .c2-reviews-nav button:hover {
    border-color: var(--c2-gold);
    color: var(--c2-gold);
  }
  @media (min-width: 900px) {
    .c2-reviews {
      padding: 7.5rem 0;
    }
  }
</style>

<script>
  const root = document.querySelector("[data-c2-reviews]");
  if (root) {
    const track = root.querySelector("[data-c2-track]") as HTMLElement | null;
    const total = root.querySelectorAll(".c2-review").length;
    let index = 0;
    const go = (i: number) => {
      index = (i + total) % total;
      if (track) track.style.transform = `translateX(-${index * 100}%)`;
    };
    root.querySelector("[data-c2-prev]")?.addEventListener("click", () => go(index - 1));
    root.querySelector("[data-c2-next]")?.addEventListener("click", () => go(index + 1));
  }
</script>
