---

<section class="c2-marquee" aria-hidden="true">
  <div class="c2-marquee-track">
    {
      Array.from({ length: 2 }).map(() => (
        <div class="c2-marquee-group">
          <span>High Quality Legal Services</span>
          <span class="dot">◆</span>
          <span>Cost Effective Advice</span>
          <span class="dot">◆</span>
          <span>Brunswick · Melbourne</span>
          <span class="dot">◆</span>
          <span>Long-Term Client Relationships</span>
          <span class="dot">◆</span>
        </div>
      ))
    }
  </div>
</section>

<style>
  .c2-marquee {
    overflow: hidden;
    background: var(--c2-gold);
    color: var(--c2-navy);
    padding: 1rem 0;
  }
  .c2-marquee-group {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-right: 1.5rem;
    font-family: "Fraunces", Georgia, serif;
    font-size: clamp(1.1rem, 2vw, 1.45rem);
    font-weight: 550;
    white-space: nowrap;
  }
  .c2-marquee-group .dot {
    font-size: 0.7rem;
    opacity: 0.55;
  }
</style>
