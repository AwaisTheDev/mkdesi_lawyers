---
import { site, nav } from "../../data/site";
---

<header class="c2-header" id="c2-header">
  <div class="c2-wrap c2-header-inner">
    <a href="#top" class="c2-logo" aria-label={site.name}>
      <img src="/logo.png" alt="" width="220" height="72" class="c2-logo-img" />
    </a>

    <nav class="c2-nav" aria-label="Primary">
      {
        nav.slice(1, 6).map((item) => (
          <a href={item.href}>{item.label}</a>
        ))
      }
    </nav>

    <div class="c2-header-actions">
      <a href="#contact" class="c2-btn c2-btn-gold c2-header-cta">Contact Us ↗</a>
      <button
        type="button"
        class="c2-menu-btn"
        id="c2-menu-toggle"
        aria-expanded="false"
        aria-controls="c2-mobile-menu"
        aria-label="Open menu"
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div class="c2-mobile" id="c2-mobile-menu" hidden>
    <div class="c2-wrap">
      {
        nav.map((item) => (
          <a href={item.href} class="c2-mobile-link">{item.label}</a>
        ))
      }
      <a href={site.phoneHref} class="c2-mobile-phone">{site.phone}</a>
    </div>
  </div>
</header>

<style>
  .c2-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    transition: background 0.3s var(--c2-ease), backdrop-filter 0.3s var(--c2-ease);
  }
  .c2-header.is-scrolled {
    background: rgba(2, 22, 43, 0.9);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }
  .c2-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 4.5rem;
    padding-block: 0.75rem;
  }
  .c2-logo-img {
    height: 2.6rem;
    width: auto;
    mix-blend-mode: screen;
  }
  .c2-nav {
    display: none;
    align-items: center;
    gap: 0.15rem;
  }
  .c2-nav a {
    padding: 0.55rem 0.75rem;
    font-size: 0.84rem;
    color: rgba(255, 255, 255, 0.72);
    transition: color 0.2s ease;
  }
  .c2-nav a:hover {
    color: #fff;
  }
  .c2-header-actions {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }
  .c2-header-cta {
    display: none;
    padding: 0.7rem 1.1rem;
    font-size: 0.8rem;
  }
  .c2-menu-btn {
    width: 2.7rem;
    height: 2.7rem;
    border-radius: 0.55rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(2, 22, 43, 0.35);
    display: grid;
    place-content: center;
    gap: 0.28rem;
    cursor: pointer;
  }
  .c2-menu-btn span {
    display: block;
    width: 1.05rem;
    height: 1.5px;
    background: #fff;
  }
  .c2-menu-btn span:nth-child(3) {
    width: 0.75rem;
  }
  .c2-mobile {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(2, 22, 43, 0.96);
    padding: 0.5rem 0 1.25rem;
  }
  .c2-mobile[hidden] {
    display: none;
  }
  .c2-mobile-link {
    display: block;
    padding: 0.9rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 0.95rem;
  }
  .c2-mobile-phone {
    display: inline-block;
    margin-top: 1rem;
    color: var(--c2-gold);
  }
  @media (min-width: 980px) {
    .c2-nav {
      display: flex;
    }
    .c2-header-cta {
      display: inline-flex;
    }
    .c2-menu-btn {
      display: none;
    }
  }
</style>

<script>
  const header = document.getElementById("c2-header");
  const toggle = document.getElementById("c2-menu-toggle");
  const menu = document.getElementById("c2-mobile-menu");

  const onScroll = () => {
    header?.classList.toggle("is-scrolled", window.scrollY > 24);
  };
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  toggle?.addEventListener("click", () => {
    const open = menu?.hasAttribute("hidden");
    if (open) menu?.removeAttribute("hidden");
    else menu?.setAttribute("hidden", "");
    toggle.setAttribute("aria-expanded", String(!!open));
  });

  document.querySelectorAll(".c2-mobile-link").forEach((link) => {
    link.addEventListener("click", () => {
      menu?.setAttribute("hidden", "");
      toggle?.setAttribute("aria-expanded", "false");
    });
  });
</script>
