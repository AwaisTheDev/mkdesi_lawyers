---
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import { site } from "../data/site";
---

<footer class="bg-navy text-white">
  <div
    class="mx-auto flex max-w-7xl flex-col gap-8 px-5 py-12 md:flex-row md:items-center md:justify-between md:px-8"
  >
    <a href="#top" aria-label={site.name}>
      <Logo class="h-12 w-auto" />
    </a>

    <ul class="flex flex-col gap-4 sm:flex-row sm:flex-wrap sm:items-center sm:gap-8">
      <li class="flex items-center gap-2.5 text-sm text-white/75">
        <Icon name="phone" class="h-4 w-4 text-gold" />
        <a href={site.phoneHref} class="no-underline hover:text-gold">{site.phone}</a>
      </li>
      <li class="flex items-center gap-2.5 text-sm text-white/75">
        <Icon name="mail" class="h-4 w-4 text-gold" />
        <a href={site.emailHref} class="no-underline hover:text-gold">{site.email}</a>
      </li>
      <li class="flex items-center gap-2.5 text-sm text-white/75">
        <Icon name="mapPin" class="h-4 w-4 shrink-0 text-gold" />
        <a
          href={site.address.mapsLink}
          class="no-underline hover:text-gold"
          target="_blank"
          rel="noopener noreferrer"
          >{site.address.full}</a
        >
      </li>
    </ul>

    <div class="flex items-center gap-3">
      <a
        href="https://www.facebook.com/"
        class="flex h-10 w-10 items-center justify-center border border-white/20 text-white/70 transition-colors hover:border-gold hover:text-gold"
        aria-label="Facebook"
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon name="facebook" class="h-4 w-4" />
      </a>
      <a
        href="https://www.linkedin.com/"
        class="flex h-10 w-10 items-center justify-center border border-white/20 text-white/70 transition-colors hover:border-gold hover:text-gold"
        aria-label="LinkedIn"
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon name="linkedin" class="h-4 w-4" />
      </a>
    </div>
  </div>

  <div class="border-t border-white/10 px-5 py-5 text-center text-xs text-white/40 md:px-8">
    <p>
      © {new Date().getFullYear()}{" "}
      {site.name}. Liability limited by a scheme approved under Professional
      Standards Legislation.
    </p>
    <p class="mt-2">
      Web development and Design by{" "}
      <a
        href="https://www.atlanticmediagroup.com.au"
        class="text-white/55 no-underline transition-colors hover:text-gold"
        target="_blank"
        rel="noopener noreferrer"
        >www.atlanticmediagroup.com.au</a
      >
    </p>
  </div>
</footer>
