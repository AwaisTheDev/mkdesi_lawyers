---
import { nav, site } from "../data/site";
import Logo from "./Logo.astro";
---

<footer class="border-t border-white/10 bg-ink-soft text-white">
  <div class="mx-auto grid max-w-7xl gap-12 px-5 py-16 md:grid-cols-12 md:px-8">
    <div class="md:col-span-5">
      <a href="#top" class="inline-block no-underline" aria-label="Makdesi And Associates Lawyers">
        <Logo class="h-14 w-auto md:h-16" />
      </a>
      <p class="mt-5 max-w-sm leading-relaxed text-white/55">
        High quality, cost effective legal services from the heart of Brunswick.
      </p>
    </div>

    <div class="md:col-span-3">
      <h2 class="text-xs font-bold uppercase tracking-[0.14em] text-white/40">
        Quick links
      </h2>
      <ul class="mt-4 space-y-2.5">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-sm text-white/70 no-underline transition-colors hover:text-gold"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="md:col-span-4">
      <h2 class="text-xs font-bold uppercase tracking-[0.14em] text-white/40">
        Contact
      </h2>
      <ul class="mt-4 space-y-3 text-sm text-white/70">
        <li>
          <a
            href={site.address.mapsLink}
            class="no-underline hover:text-gold"
            target="_blank"
            rel="noopener noreferrer"
          >
            {site.address.full}
          </a>
        </li>
        <li>
          <a href={site.phoneHref} class="no-underline hover:text-gold"
            >{site.phone}</a
          >
        </li>
        <li>
          <a href={site.emailHref} class="no-underline hover:text-gold"
            >{site.email}</a
          >
        </li>
      </ul>
    </div>
  </div>

  <div
    class="border-t border-white/10 px-5 py-6 text-center text-xs text-white/40 md:px-8"
  >
    <p>
      © {new Date().getFullYear()}{" "}
      {site.name}. All rights reserved. Liability limited by a scheme approved
      under Professional Standards Legislation.
    </p>
    <p class="mt-2">
      Web development and Design by{" "}
      <a
        href="https://www.atlanticmediagroup.com.au"
        class="text-white/55 no-underline transition-colors hover:text-gold"
        target="_blank"
        rel="noopener noreferrer"
        >www.atlanticmediagroup.com.au</a
      >
    </p>
  </div>
</footer>
