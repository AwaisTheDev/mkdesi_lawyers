---
import { site } from "../data/site";
---

<section id="location" class="bg-cream py-24 md:py-32">
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
      <div>
        <p class="section-label reveal">Our location</p>
        <h2
          class="reveal reveal-delay-1 mt-5 font-display text-4xl leading-tight font-semibold tracking-tight text-ink md:text-5xl"
        >
          Find us in Brunswick
        </h2>
        <p class="reveal reveal-delay-2 mt-5 max-w-md text-lg leading-relaxed text-slate">
          In the heart of Brunswick — close to local and city courts, and easy
          to reach for clients across Melbourne.
        </p>

        <div class="reveal reveal-delay-2 mt-8 overflow-hidden">
          <img
            src="/images/office-exterior.webp"
            alt="Makdesi And Associates Lawyers office exterior at 705 Sydney Road, Brunswick"
            class="aspect-[4/5] w-full max-w-md object-cover"
            width="1600"
            height="2400"
            loading="lazy"
          />
        </div>

        <dl class="reveal reveal-delay-3 mt-10 space-y-6">
          <div>
            <dt class="text-xs font-bold uppercase tracking-[0.14em] text-mist">
              Address
            </dt>
            <dd class="mt-2 text-lg text-ink">
              <a
                href={site.address.mapsLink}
                class="no-underline transition-colors hover:text-gold-deep"
                target="_blank"
                rel="noopener noreferrer"
              >
                {site.address.line1}<br />
                {site.address.line2}
              </a>
            </dd>
          </div>
          <div>
            <dt class="text-xs font-bold uppercase tracking-[0.14em] text-mist">
              Phone
            </dt>
            <dd class="mt-2 text-lg">
              <a href={site.phoneHref} class="text-ink no-underline hover:text-gold-deep"
                >{site.phone}</a
              >
            </dd>
          </div>
          <div>
            <dt class="text-xs font-bold uppercase tracking-[0.14em] text-mist">
              Email
            </dt>
            <dd class="mt-2 text-lg">
              <a
                href={site.emailHref}
                class="text-ink no-underline hover:text-gold-deep"
                >{site.email}</a
              >
            </dd>
          </div>
        </dl>
      </div>

      <div class="reveal reveal-delay-2 min-h-[320px] overflow-hidden bg-ink-soft lg:min-h-[480px]">
        <iframe
          title="Map showing Makdesi And Associates Lawyers at 705 Sydney Road, Brunswick"
          src="https://maps.google.com/maps?q=705%20Sydney%20Road%2C%20Brunswick%20VIC%203056&t=&z=15&ie=UTF8&iwloc=&output=embed"
          class="h-full min-h-[320px] w-full border-0 lg:min-h-[480px]"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen></iframe>
      </div>
    </div>
  </div>
</section>
