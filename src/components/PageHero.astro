---
interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
  image?: string;
  imageAlt?: string;
}

const {
  title,
  description,
  eyebrow,
  image = "/images/inner-banner.webp",
  imageAlt = "Makdesi & Associates Lawyers reception",
} = Astro.props;
---

<section class="relative overflow-hidden bg-navy pt-28 pb-16 text-white md:pt-32 md:pb-20">
  <div class="absolute inset-0">
    <img
      src={image}
      alt={imageAlt}
      class="h-full w-full object-cover object-center"
      width="2400"
      height="1400"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-navy via-navy/85 to-navy/55"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-navy/70 via-transparent to-navy/40"></div>
  </div>
  <div class="relative z-10 mx-auto max-w-7xl px-5 md:px-8">
    {
      eyebrow ? (
        <p class="text-xs font-bold uppercase tracking-[0.14em] text-gold">{eyebrow}</p>
      ) : null
    }
    <h1
      class:list={[
        "max-w-3xl font-display text-[clamp(2.2rem,4.5vw,3.6rem)] font-semibold leading-[1.1] tracking-tight text-balance",
        eyebrow && "mt-3",
      ]}
    >
      {title}
    </h1>
    {
      description ? (
        <p class="mt-5 max-w-2xl text-base leading-relaxed text-white/65 md:text-lg">
          {description}
        </p>
      ) : null
    }
  </div>
</section>
