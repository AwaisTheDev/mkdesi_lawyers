---
import { team } from "../data/site";
---

<section id="team" class="bg-cream py-24 md:py-32">
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <div class="max-w-xl">
        <p class="section-label reveal">Our people</p>
        <h2
          class="reveal reveal-delay-1 mt-5 font-display text-4xl leading-tight font-semibold tracking-tight text-ink md:text-5xl"
        >
          Meet the team
        </h2>
        <p class="reveal reveal-delay-2 mt-5 text-lg leading-relaxed text-slate">
          A dedicated group of lawyers and support staff ready to listen and
          give objective advice when it matters most.
        </p>
      </div>
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
      {
        team.map((member, i) => (
          <article
            class:list={[
              "reveal group",
              i === 1 && "reveal-delay-1",
              i === 2 && "reveal-delay-2",
              i >= 3 && "reveal-delay-3",
            ]}
          >
            <div
              class="relative flex aspect-[3/4] items-end overflow-hidden bg-ink-soft"
            >
              {member.photo ? (
                <img
                  src={member.photo}
                  alt={`${member.name}, ${member.role}`}
                  class="absolute inset-0 h-full w-full object-cover object-top transition-transform duration-700 group-hover:scale-[1.03]"
                  width="900"
                  height="1200"
                  loading="lazy"
                />
              ) : (
                <>
                  <div
                    class="absolute inset-0 bg-gradient-to-br from-slate via-ink-soft to-ink"
                    aria-hidden="true"
                  />
                  <span
                    class="absolute inset-0 flex items-center justify-center font-display text-6xl font-semibold text-white/15"
                    aria-hidden="true"
                  >
                    {member.initials}
                  </span>
                </>
              )}
              <div class="relative z-10 w-full bg-gradient-to-t from-ink via-ink/80 to-transparent p-5 pt-16">
                <h3 class="font-display text-xl font-semibold text-white">
                  {member.name}
                </h3>
                <p class="mt-1 text-sm tracking-wide text-gold">{member.role}</p>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
