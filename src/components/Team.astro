---
import { team } from "../data/site";
---

<section id="team" class="bg-navy py-20 text-white md:py-28">
  <div class="mx-auto grid max-w-7xl items-center gap-12 px-5 md:grid-cols-12 md:gap-16 md:px-8">
    <div class="md:col-span-4">
      <h2
        class="reveal font-display text-4xl font-semibold tracking-tight md:text-5xl"
      >
        Meet Our Team
      </h2>
      <p class="reveal reveal-delay-1 mt-5 max-w-sm text-base leading-relaxed text-white/65">
        A dedicated team ready to listen and give clear, objective advice when
        it matters most — led by Principal Mary Makdesi.
      </p>
      <a href="#contact" class="btn-gold reveal reveal-delay-2 mt-8">
        Meet the Team
      </a>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 md:col-span-8">
      {
        team.map((member, i) => (
          <article
            class:list={[
              "reveal",
              i === 1 && "reveal-delay-1",
            ]}
          >
            <div class="overflow-hidden border border-white/15 bg-navy-soft">
              {member.photo ? (
                <img
                  src={member.photo}
                  alt={`${member.name}, ${member.role}`}
                  class="aspect-[4/5] w-full object-cover object-top"
                  width="900"
                  height="1125"
                  loading="lazy"
                />
              ) : null}
            </div>
            <h3 class="mt-4 font-display text-xl font-semibold">{member.name}</h3>
            <p class="mt-1 text-sm tracking-wide text-gold">{member.role}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
