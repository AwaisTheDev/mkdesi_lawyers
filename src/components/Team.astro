---
import { team } from "../data/site";
---
<section id="team" class="bg-navy py-20 text-white md:py-28">
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between md:gap-12">
      <div class="max-w-xl">
        <h2
          class="font-display text-4xl font-semibold tracking-tight md:text-5xl"
        >
          Meet Our Team
        </h2>
        <p class="mt-5 text-base leading-relaxed text-white/65">
          A dedicated team ready to listen and give clear, objective advice when
          it matters most — led by Principal Lawyer Mary Makdesi.
        </p>
      </div>

      <a href="/team" class="btn-gold shrink-0 whitespace-nowrap self-start md:self-auto">
        View all profiles
      </a>
    </div>

    <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        team.map((member) => (
          <article>
            <a
              href={`/team/${member.slug}`}
              class="group block text-inherit no-underline"
            >
              <div class="overflow-hidden border border-white/15 bg-white">
                {member.photo ? (
                  <img
                    src={member.photo}
                    alt={`${member.name}, ${member.role}`}
                    class="aspect-[4/5] w-full bg-white object-cover object-top transition-transform duration-700 group-hover:scale-[1.03]"
                    width="900"
                    height="1125"
                    loading="lazy"
                  />
                ) : (
                  <div class="flex aspect-[4/5] items-center justify-center bg-white font-display text-4xl text-gold/70">
                    {member.initials}
                  </div>
                )}
              </div>
              <h3 class="mt-4 font-display text-xl font-semibold group-hover:text-gold">
                {member.name}
              </h3>
              <p class="mt-1 text-sm tracking-wide text-gold">{member.role}</p>
              <p class="mt-3 text-sm leading-relaxed text-white/55 line-clamp-3">
                {member.bio}
              </p>
              <span class="mt-4 inline-flex items-center gap-1.5 text-[0.72rem] font-bold uppercase tracking-[0.12em] text-gold">
                View profile
                <span aria-hidden="true">→</span>
              </span>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
