---
import { site, team } from "../data/site";
---

<section id="team" class="bg-navy py-20 text-white md:py-28">
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <div class="grid items-end gap-8 md:grid-cols-12 md:gap-12">
      <div class="md:col-span-5">
        <h2
          class="font-display text-4xl font-semibold tracking-tight md:text-5xl"
        >
          Meet Our Team
        </h2>
        <p class="mt-5 max-w-md text-base leading-relaxed text-white/65">
          A dedicated team ready to listen and give clear, objective advice when
          it matters most — led by Principal Lawyer Mary Makdesi.
        </p>
        <p class="mt-4 max-w-md text-sm leading-relaxed text-white/50">
          Mary is also Director & Principal Lawyer of sister firm{" "}
          <a
            href={site.sisterFirm.url}
            class="text-gold no-underline transition-colors hover:text-gold-bright"
            target="_blank"
            rel="noopener noreferrer"
            >{site.sisterFirm.name}</a
          >.
        </p>
        <a href="/team" class="btn-gold mt-8">
          View all profiles
        </a>
      </div>

      <div
        class="flex items-center justify-start gap-3 md:col-span-7 md:justify-end"
      >
        <button
          type="button"
          class="flex h-11 w-11 items-center justify-center border border-white/25 text-white transition-colors hover:border-gold hover:text-gold"
          data-team-prev
          aria-label="Previous team members"
        >
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.75">
            <path d="M15 6 9 12l6 6" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
        <button
          type="button"
          class="flex h-11 w-11 items-center justify-center border border-white/25 text-white transition-colors hover:border-gold hover:text-gold"
          data-team-next
          aria-label="Next team members"
        >
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.75">
            <path d="m9 6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
      </div>
    </div>

    <div class="mt-12" data-team-slider>
      <div class="overflow-hidden">
        <div
          class="flex gap-6 transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)]"
          data-team-track
          style="transform: translateX(0px)"
        >
          {
            team.map((member) => (
              <article
                class="w-[min(100%,320px)] shrink-0 sm:w-[calc(50%-0.75rem)] lg:w-[calc(33.333%-1rem)]"
                data-team-card
              >
                <a
                  href={`/team/${member.slug}`}
                  class="group block text-inherit no-underline"
                >
                  <div class="overflow-hidden border border-white/15 bg-navy-soft">
                    {member.photo ? (
                      <img
                        src={member.photo}
                        alt={`${member.name}, ${member.role}`}
                        class="aspect-[4/5] w-full object-cover object-top transition-transform duration-700 group-hover:scale-[1.03]"
                        width="900"
                        height="1125"
                        loading="lazy"
                      />
                    ) : (
                      <div class="flex aspect-[4/5] items-center justify-center bg-navy-soft font-display text-4xl text-gold/70">
                        {member.initials}
                      </div>
                    )}
                  </div>
                  <h3 class="mt-4 font-display text-xl font-semibold group-hover:text-gold">
                    {member.name}
                  </h3>
                  <p class="mt-1 text-sm tracking-wide text-gold">{member.role}</p>
                  <p class="mt-3 text-sm leading-relaxed text-white/55 line-clamp-3">
                    {member.bio}
                  </p>
                  <span class="mt-4 inline-flex items-center gap-1.5 text-[0.72rem] font-bold uppercase tracking-[0.12em] text-gold">
                    View profile
                    <span aria-hidden="true">→</span>
                  </span>
                </a>
              </article>
            ))
          }
        </div>
      </div>

      <div class="mt-8 flex items-center justify-center gap-2" data-team-dots></div>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector("[data-team-slider]");
  if (root) {
    const track = root.querySelector("[data-team-track]") as HTMLElement | null;
    const cards = Array.from(root.querySelectorAll("[data-team-card]")) as HTMLElement[];
    const dotsWrap = root.querySelector("[data-team-dots]");
    const prevBtn = document.querySelector("[data-team-prev]");
    const nextBtn = document.querySelector("[data-team-next]");
    let index = 0;

    const perView = () => {
      if (window.matchMedia("(min-width: 1024px)").matches) return 3;
      if (window.matchMedia("(min-width: 640px)").matches) return 2;
      return 1;
    };

    const maxIndex = () => Math.max(0, cards.length - perView());

    const step = () => {
      if (!cards[0] || !track) return 0;
      const style = getComputedStyle(track);
      const gap = parseFloat(style.columnGap || style.gap || "0") || 0;
      return cards[0].getBoundingClientRect().width + gap;
    };

    const renderDots = () => {
      if (!dotsWrap) return;
      dotsWrap.innerHTML = "";
      const total = maxIndex() + 1;
      for (let i = 0; i < total; i++) {
        const dot = document.createElement("button");
        dot.type = "button";
        dot.setAttribute("aria-label", `Go to team slide ${i + 1}`);
        dot.className = `h-2.5 rounded-full transition-all ${
          i === index ? "w-6 bg-gold" : "w-2.5 bg-white/25"
        }`;
        dot.addEventListener("click", () => go(i));
        dotsWrap.appendChild(dot);
      }
    };

    const go = (i: number) => {
      index = Math.min(Math.max(i, 0), maxIndex());
      if (track) track.style.transform = `translateX(-${index * step()}px)`;
      renderDots();
    };

    prevBtn?.addEventListener("click", () => go(index - 1));
    nextBtn?.addEventListener("click", () => go(index + 1));
    window.addEventListener("resize", () => go(Math.min(index, maxIndex())));

    go(0);
  }
</script>
