---
import { site, nav } from "../data/site";
import Logo from "./Logo.astro";

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

function isActive(href: string) {
  if (href === "/") return pathname === "/";
  return pathname === href || pathname.startsWith(`${href}/`);
}
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 border-b border-navy/8 bg-white transition-shadow duration-300"
>
  <div
    class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-3 md:px-8"
  >
    <a href="/" class="shrink-0" aria-label={site.name}>
      <Logo variant="on-light" class="h-10 w-auto md:h-12" />
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              "px-3 py-2 text-[0.72rem] font-semibold uppercase tracking-[0.12em] no-underline transition-colors",
              isActive(item.href)
                ? "text-navy"
                : "text-navy/70 hover:text-navy",
            ]}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <a href={site.phoneHref} class="btn-gold hidden sm:inline-flex">
        Call {site.phone}
      </a>
      <button
        id="menu-toggle"
        type="button"
        class="flex h-11 w-11 items-center justify-center border border-navy/15 text-navy lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <span class="flex w-5 flex-col gap-1.5" aria-hidden="true">
          <span class="block h-px w-full bg-current"></span>
          <span class="block h-px w-full bg-current"></span>
          <span class="block h-px w-3/4 bg-current"></span>
        </span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-navy/8 bg-white lg:hidden">
    <nav class="mx-auto flex max-w-7xl flex-col px-5 py-3" aria-label="Mobile">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              "mobile-link border-b border-navy/8 py-3.5 text-sm font-semibold uppercase tracking-[0.1em] no-underline",
              isActive(item.href) ? "text-navy" : "text-navy/80",
            ]}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a href={site.phoneHref} class="btn-gold mt-4 self-start">
        Call {site.phone}
      </a>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById("site-header");
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");

  const onScroll = () => {
    if (!header) return;
    header.classList.toggle("shadow-md", window.scrollY > 8);
  };
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  toggle?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(open));
  });

  document.querySelectorAll(".mobile-link").forEach((link) => {
    link.addEventListener("click", () => {
      menu?.classList.add("hidden");
      toggle?.setAttribute("aria-expanded", "false");
    });
  });
</script>
