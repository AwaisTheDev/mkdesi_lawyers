---
import { site, nav } from "../data/site";
import Logo from "./Logo.astro";
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 transition-all duration-300"
>
  <div
    class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-5 py-3 md:px-8 md:py-4"
  >
    <a href="#top" class="shrink-0 no-underline" aria-label="Makdesi And Associates Lawyers">
      <Logo class="h-10 w-auto sm:h-12 md:h-[3.25rem]" />
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary">
      {
        nav.slice(1).map((item) => (
          <a
            href={item.href}
            class="px-3 py-2 text-[0.78rem] font-medium uppercase tracking-[0.08em] text-white/75 no-underline transition-colors hover:text-white"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <a
        href="#contact"
        class="hidden bg-gold px-4 py-2.5 text-[0.72rem] font-bold uppercase tracking-[0.1em] text-ink no-underline transition-colors hover:bg-gold-bright sm:inline-flex"
      >
        Contact Us
      </a>
      <button
        id="menu-toggle"
        type="button"
        class="flex h-11 w-11 items-center justify-center border border-white/25 bg-ink/30 text-white lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <span class="flex w-5 flex-col gap-1.5" aria-hidden="true">
          <span class="menu-line block h-px w-full bg-current"></span>
          <span class="menu-line block h-px w-full bg-current"></span>
          <span class="menu-line block h-px w-3/4 bg-current"></span>
        </span>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="hidden border-t border-white/10 bg-ink/95 backdrop-blur-md lg:hidden"
  >
    <nav class="mx-auto flex max-w-7xl flex-col px-5 py-4" aria-label="Mobile">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="mobile-link border-b border-white/8 py-3.5 text-sm font-medium uppercase tracking-[0.1em] text-white/85 no-underline"
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={site.phoneHref}
        class="mt-4 text-sm text-gold no-underline">{site.phone}</a
      >
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById("site-header");
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const links = document.querySelectorAll(".mobile-link");

  const onScroll = () => {
    if (!header) return;
    if (window.scrollY > 40) {
      header.classList.add("bg-ink/90", "backdrop-blur-md", "shadow-lg");
    } else {
      header.classList.remove("bg-ink/90", "backdrop-blur-md", "shadow-lg");
    }
  };

  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  toggle?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
  });

  links.forEach((link) => {
    link.addEventListener("click", () => {
      menu?.classList.add("hidden");
      toggle?.setAttribute("aria-expanded", "false");
    });
  });
</script>
