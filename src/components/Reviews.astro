---
import { reviews } from "../data/site";
---

<section id="reviews" class="bg-paper py-24 md:py-32">
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <div class="max-w-2xl">
      <p class="section-label reveal">Client reviews</p>
      <h2
        class="reveal reveal-delay-1 mt-5 font-display text-4xl leading-tight font-semibold tracking-tight text-ink md:text-5xl"
      >
        Voices of confidence in difficult times
      </h2>
    </div>

    <div class="relative mt-14" data-reviews>
      <div class="overflow-hidden">
        <div
          class="flex transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)]"
          data-track
          style="transform: translateX(0%)"
        >
          {
            reviews.map((review) => (
              <blockquote class="w-full shrink-0 pr-0 md:pr-8">
                <div class="max-w-3xl border-l-2 border-gold pl-6 md:pl-10">
                  <p class="font-display text-2xl leading-snug text-ink md:text-3xl">
                    “{review.quote}”
                  </p>
                  <footer class="mt-8">
                    <cite class="not-italic">
                      <span class="block text-sm font-bold uppercase tracking-[0.12em] text-gold-deep">
                        {review.name}
                      </span>
                      <span class="mt-1 block text-sm text-mist">Client</span>
                    </cite>
                  </footer>
                </div>
              </blockquote>
            ))
          }
        </div>
      </div>

      <div class="mt-10 flex items-center gap-3">
        <button
          type="button"
          data-prev
          class="flex h-12 w-12 items-center justify-center border border-ink/15 text-ink transition-colors hover:border-ink hover:bg-ink hover:text-white"
          aria-label="Previous review"
        >
          <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path
              d="M13 8H3M7 4L3 8l4 4"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </button>
        <button
          type="button"
          data-next
          class="flex h-12 w-12 items-center justify-center border border-ink/15 text-ink transition-colors hover:border-ink hover:bg-ink hover:text-white"
          aria-label="Next review"
        >
          <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path
              d="M3 8h10M9 4l4 4-4 4"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </button>
        <div class="ml-4 flex gap-2" data-dots aria-hidden="true"></div>
      </div>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector("[data-reviews]");
  if (root) {
    const track = root.querySelector("[data-track]") as HTMLElement | null;
    const prev = root.querySelector("[data-prev]");
    const next = root.querySelector("[data-next]");
    const dotsWrap = root.querySelector("[data-dots]");
    const total = root.querySelectorAll("blockquote").length;
    let index = 0;

    const renderDots = () => {
      if (!dotsWrap) return;
      dotsWrap.innerHTML = "";
      for (let i = 0; i < total; i++) {
        const dot = document.createElement("button");
        dot.type = "button";
        dot.setAttribute("aria-label", `Go to review ${i + 1}`);
        dot.className = `h-2 w-2 rounded-full transition-all ${
          i === index ? "w-6 bg-gold" : "bg-ink/20"
        }`;
        dot.addEventListener("click", () => go(i));
        dotsWrap.appendChild(dot);
      }
    };

    const go = (i: number) => {
      index = (i + total) % total;
      if (track) track.style.transform = `translateX(-${index * 100}%)`;
      renderDots();
    };

    prev?.addEventListener("click", () => go(index - 1));
    next?.addEventListener("click", () => go(index + 1));
    renderDots();
  }
</script>
