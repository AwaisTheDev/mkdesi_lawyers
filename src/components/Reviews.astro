---
import Icon from "./Icon.astro";
import { reviews } from "../data/site";
---

<section id="reviews" class="bg-white py-20 md:py-28">
  <div class="mx-auto max-w-3xl px-5 text-center md:px-8">
    <div class="reveal">
      <Icon name="quote" class="mx-auto h-10 w-10 text-gold" />
    </div>

    <div class="relative mt-8" data-reviews>
      <div class="overflow-hidden">
        <div
          class="flex transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)]"
          data-track
          style="transform: translateX(0%)"
        >
          {
            reviews.map((review) => (
              <blockquote class="w-full shrink-0 px-1">
                <p class="font-display text-2xl leading-snug text-navy md:text-3xl">
                  “{review.quote}”
                </p>
                <footer class="mt-8">
                  <cite class="not-italic text-sm font-semibold uppercase tracking-[0.12em] text-gold">
                    — {review.name}
                  </cite>
                </footer>
              </blockquote>
            ))
          }
        </div>
      </div>

      <div class="mt-10 flex items-center justify-center gap-2" data-dots></div>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector("[data-reviews]");
  if (root) {
    const track = root.querySelector("[data-track]") as HTMLElement | null;
    const dotsWrap = root.querySelector("[data-dots]");
    const total = root.querySelectorAll("blockquote").length;
    let index = 0;

    const renderDots = () => {
      if (!dotsWrap) return;
      dotsWrap.innerHTML = "";
      for (let i = 0; i < total; i++) {
        const dot = document.createElement("button");
        dot.type = "button";
        dot.setAttribute("aria-label", `Go to review ${i + 1}`);
        dot.className = `h-2.5 w-2.5 rounded-full transition-all ${
          i === index ? "bg-gold w-6" : "bg-navy/20"
        }`;
        dot.addEventListener("click", () => go(i));
        dotsWrap.appendChild(dot);
      }
    };

    const go = (i: number) => {
      index = (i + total) % total;
      if (track) track.style.transform = `translateX(-${index * 100}%)`;
      renderDots();
    };

    renderDots();
    setInterval(() => go(index + 1), 7000);
  }
</script>
