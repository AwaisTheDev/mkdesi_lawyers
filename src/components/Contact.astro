---
import Icon from "./Icon.astro";
import { practiceAreas, site } from "../data/site";
---

<section id="contact" class="bg-cream py-20 md:py-28">
  <div class="mx-auto grid max-w-7xl gap-12 px-5 md:grid-cols-12 md:gap-16 md:px-8">
    <div class="md:col-span-5">
      <h2 class="reveal font-display text-4xl font-semibold tracking-tight text-navy md:text-5xl">
        Get In Touch
      </h2>
      <p class="reveal reveal-delay-1 mt-4 max-w-md text-base leading-relaxed text-slate">
        Tell us briefly about your matter. We’ll respond as soon as we can.
      </p>

      <ul class="reveal reveal-delay-2 mt-10 space-y-5">
        <li class="flex items-start gap-4">
          <span class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center border border-gold text-gold">
            <Icon name="phone" class="h-5 w-5" />
          </span>
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.12em] text-mist">Phone</p>
            <a href={site.phoneHref} class="mt-1 block text-lg text-navy no-underline hover:text-gold"
              >{site.phone}</a
            >
          </div>
        </li>
        <li class="flex items-start gap-4">
          <span class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center border border-gold text-gold">
            <Icon name="mail" class="h-5 w-5" />
          </span>
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.12em] text-mist">Email</p>
            <a href={site.emailHref} class="mt-1 block text-lg text-navy no-underline hover:text-gold"
              >{site.email}</a
            >
          </div>
        </li>
        <li class="flex items-start gap-4">
          <span class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center border border-gold text-gold">
            <Icon name="mapPin" class="h-5 w-5" />
          </span>
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.12em] text-mist">Address</p>
            <a
              href={site.address.mapsLink}
              class="mt-1 block text-lg text-navy no-underline hover:text-gold"
              target="_blank"
              rel="noopener noreferrer"
            >
              {site.address.line1}<br />{site.address.line2}
            </a>
          </div>
        </li>
      </ul>
    </div>

    <form
      class="reveal reveal-delay-1 grid gap-4 bg-white p-6 shadow-sm md:col-span-7 md:p-8"
      action={`mailto:${site.email}`}
      method="post"
      enctype="text/plain"
    >
      <h3 class="font-display text-2xl font-semibold text-navy">Send Us an Enquiry</h3>
      <label class="block">
        <span class="mb-1.5 block text-xs font-bold uppercase tracking-[0.1em] text-mist"
          >Full name</span
        >
        <input
          type="text"
          name="name"
          required
          autocomplete="name"
          class="w-full border border-navy/12 bg-cream px-4 py-3.5 text-navy outline-none transition-colors focus:border-gold"
        />
      </label>
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="block">
          <span class="mb-1.5 block text-xs font-bold uppercase tracking-[0.1em] text-mist"
            >Email</span
          >
          <input
            type="email"
            name="email"
            required
            autocomplete="email"
            class="w-full border border-navy/12 bg-cream px-4 py-3.5 text-navy outline-none transition-colors focus:border-gold"
          />
        </label>
        <label class="block">
          <span class="mb-1.5 block text-xs font-bold uppercase tracking-[0.1em] text-mist"
            >Phone</span
          >
          <input
            type="tel"
            name="phone"
            autocomplete="tel"
            class="w-full border border-navy/12 bg-cream px-4 py-3.5 text-navy outline-none transition-colors focus:border-gold"
          />
        </label>
      </div>
      <label class="block">
        <span class="mb-1.5 block text-xs font-bold uppercase tracking-[0.1em] text-mist"
          >Practice area</span
        >
        <select
          name="practice_area"
          required
          class="w-full appearance-none border border-navy/12 bg-cream px-4 py-3.5 text-navy outline-none transition-colors focus:border-gold"
        >
          <option value="" disabled selected>Select a practice area</option>
          {
            practiceAreas.map((area) => (
              <option value={area.title}>{area.title}</option>
            ))
          }
          <option value="Other">Other / Not sure</option>
        </select>
      </label>
      <label class="block">
        <span class="mb-1.5 block text-xs font-bold uppercase tracking-[0.1em] text-mist"
          >Message</span
        >
        <textarea
          name="message"
          required
          rows="5"
          class="w-full resize-y border border-navy/12 bg-cream px-4 py-3.5 text-navy outline-none transition-colors focus:border-gold"
        ></textarea>
      </label>
      <button type="submit" class="btn-gold mt-2 self-start">Send Enquiry</button>
    </form>
  </div>
</section>
