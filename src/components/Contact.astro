---
import { practiceAreas, site } from "../data/site";
---

<section id="contact" class="relative overflow-hidden bg-ink py-24 text-white md:py-32">
  <div
    class="pointer-events-none absolute -left-20 bottom-0 h-80 w-80 rounded-full bg-gold/10 blur-3xl"
  >
  </div>
  <div class="relative mx-auto grid max-w-7xl gap-14 px-5 md:grid-cols-12 md:px-8">
    <div class="md:col-span-5">
      <p class="section-label !text-gold reveal">Get in touch</p>
      <h2
        class="reveal reveal-delay-1 mt-5 font-display text-4xl leading-tight font-semibold tracking-tight md:text-5xl"
      >
        Send an enquiry
      </h2>
      <p class="reveal reveal-delay-2 mt-5 max-w-md text-lg leading-relaxed text-white/65">
        Tell us briefly about your matter. We’ll respond as soon as we can —
        or call us on{" "}
        <a href={site.phoneHref} class="text-gold no-underline hover:underline"
          >{site.phone}</a
        >.
      </p>
    </div>

    <form
      class="reveal reveal-delay-2 grid gap-5 md:col-span-7"
      action={`mailto:${site.email}`}
      method="post"
      enctype="text/plain"
    >
      <div class="grid gap-5 sm:grid-cols-2">
        <label class="block">
          <span class="mb-2 block text-xs font-bold uppercase tracking-[0.12em] text-white/50"
            >Full name</span
          >
          <input
            type="text"
            name="name"
            required
            autocomplete="name"
            class="w-full border border-white/15 bg-white/5 px-4 py-3.5 text-white outline-none transition-colors placeholder:text-white/30 focus:border-gold"
            placeholder="Your name"
          />
        </label>
        <label class="block">
          <span class="mb-2 block text-xs font-bold uppercase tracking-[0.12em] text-white/50"
            >Email</span
          >
          <input
            type="email"
            name="email"
            required
            autocomplete="email"
            class="w-full border border-white/15 bg-white/5 px-4 py-3.5 text-white outline-none transition-colors placeholder:text-white/30 focus:border-gold"
            placeholder="you@example.com"
          />
        </label>
      </div>
      <div class="grid gap-5 sm:grid-cols-2">
        <label class="block">
          <span class="mb-2 block text-xs font-bold uppercase tracking-[0.12em] text-white/50"
            >Phone</span
          >
          <input
            type="tel"
            name="phone"
            autocomplete="tel"
            class="w-full border border-white/15 bg-white/5 px-4 py-3.5 text-white outline-none transition-colors placeholder:text-white/30 focus:border-gold"
            placeholder="04xx xxx xxx"
          />
        </label>
        <label class="block">
          <span class="mb-2 block text-xs font-bold uppercase tracking-[0.12em] text-white/50"
            >Practice area</span
          >
          <select
            name="practice_area"
            required
            class="w-full appearance-none border border-white/15 bg-white/5 px-4 py-3.5 text-white outline-none transition-colors focus:border-gold"
          >
            <option value="" disabled selected class="bg-ink text-white"
              >Select a practice area</option
            >
            {
              practiceAreas.map((area) => (
                <option value={area.title} class="bg-ink text-white">
                  {area.title}
                </option>
              ))
            }
            <option value="Other" class="bg-ink text-white">Other / Not sure</option>
          </select>
        </label>
      </div>
      <label class="block">
        <span class="mb-2 block text-xs font-bold uppercase tracking-[0.12em] text-white/50"
          >Message</span
        >
        <textarea
          name="message"
          required
          rows="5"
          class="w-full resize-y border border-white/15 bg-white/5 px-4 py-3.5 text-white outline-none transition-colors placeholder:text-white/30 focus:border-gold"
          placeholder="Briefly describe your matter…"
        ></textarea>
      </label>
      <div class="flex flex-wrap items-center gap-4 pt-2">
        <button type="submit" class="btn-primary">Send enquiry</button>
        <p class="text-sm text-white/45">
          Submissions go to {site.email}
        </p>
      </div>
    </form>
  </div>
</section>
