---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import CTA from "../../components/CTA.astro";
import Icon from "../../components/Icon.astro";
import { getTeamMember, site, team } from "../../data/site";

export function getStaticPaths() {
  return team.map((member) => ({
    params: { slug: member.slug },
  }));
}

const { slug } = Astro.params;
const member = getTeamMember(slug!);
if (!member) {
  throw new Error(`Unknown team member: ${slug}`);
}

const others = team.filter((m) => m.slug !== member.slug);
---

<BaseLayout
  title={`${member.name} — ${member.role} | ${site.name}`}
  description={member.bio}
>
  <Header />
  <main>
    <section class="relative overflow-hidden bg-navy pt-28 pb-16 text-white md:pt-32 md:pb-20">
      <div class="absolute inset-0">
        <img
          src="/images/inner-banner.webp"
          alt="Makdesi & Associates Lawyers reception"
          class="h-full w-full object-cover object-center"
          width="2400"
          height="1400"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-navy via-navy/85 to-navy/55"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-navy/70 via-transparent to-navy/40"></div>
      </div>
      <div class="relative z-10 mx-auto max-w-7xl px-5 md:px-8">
        <a
          href="/team"
          class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.14em] text-gold no-underline hover:text-gold-bright"
        >
          <span aria-hidden="true">←</span> Our Team
        </a>
      </div>
    </section>

    <section class="bg-white py-14 md:py-20">
      <div class="mx-auto grid max-w-7xl gap-12 px-5 md:grid-cols-12 md:gap-16 md:px-8">
        <div class="md:col-span-5">
          <div class="overflow-hidden border border-navy/10 bg-cream">
            {
              member.photo ? (
                <img
                  src={member.photo}
                  alt={`${member.name}, ${member.role}`}
                  class="aspect-[4/5] w-full object-cover object-top"
                  width="900"
                  height="1125"
                />
              ) : (
                <div class="flex aspect-[4/5] items-center justify-center font-display text-5xl text-gold/70">
                  {member.initials}
                </div>
              )
            }
          </div>
        </div>

        <div class="md:col-span-7">
          <p class="text-xs font-bold uppercase tracking-[0.14em] text-gold">
            {member.role}
          </p>
          <h1 class="mt-3 font-display text-[clamp(2.2rem,4vw,3.4rem)] font-semibold tracking-tight text-navy">
            {member.name}
          </h1>
          <p class="mt-5 text-lg leading-relaxed text-slate">{member.bio}</p>

          {
            member.focus?.length ? (
              <div class="mt-8">
                <p class="text-xs font-bold uppercase tracking-[0.14em] text-mist">
                  Areas of focus
                </p>
                <ul class="mt-3 flex flex-wrap gap-2">
                  {member.focus.map((item) => (
                    <li class="border border-navy/12 bg-cream px-3 py-1.5 text-sm text-navy">
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
            ) : null
          }

          <div class="mt-10 flex flex-wrap gap-3">
            <a href="/contact" class="btn-gold">Speak with our team</a>
            <a href={site.phoneHref} class="btn-outline-dark">
              <Icon name="phone" class="h-4 w-4" />
              Call {site.phone}
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="border-t border-navy/8 bg-cream py-14 md:py-20">
      <div class="mx-auto max-w-3xl px-5 md:px-8">
        <h2 class="font-display text-3xl font-semibold text-navy md:text-4xl">
          Biography
        </h2>
        <div class="mt-8 space-y-5">
          {
            member.paragraphs.map((paragraph) => (
              <p class="text-base leading-relaxed text-slate md:text-lg">
                {paragraph}
              </p>
            ))
          }
        </div>
      </div>
    </section>

    <section class="bg-white py-14 md:py-20">
      <div class="mx-auto max-w-7xl px-5 md:px-8">
        <div class="flex items-end justify-between gap-4">
          <h2 class="font-display text-3xl font-semibold text-navy">
            Other team members
          </h2>
          <a
            href="/team"
            class="hidden text-[0.72rem] font-bold uppercase tracking-[0.12em] text-gold no-underline hover:text-gold-deep sm:inline"
          >
            View all →
          </a>
        </div>
        <div class="mt-10 grid gap-8 sm:grid-cols-3">
          {
            others.map((other) => (
              <a
                href={`/team/${other.slug}`}
                class="group block no-underline"
              >
                <div class="overflow-hidden border border-navy/10 bg-cream">
                  {other.photo ? (
                    <img
                      src={other.photo}
                      alt={`${other.name}, ${other.role}`}
                      class="aspect-[4/5] w-full object-cover object-top transition-transform duration-700 group-hover:scale-[1.03]"
                      width="600"
                      height="750"
                      loading="lazy"
                    />
                  ) : null}
                </div>
                <h3 class="mt-4 font-display text-xl font-semibold text-navy group-hover:text-gold-deep">
                  {other.name}
                </h3>
                <p class="mt-1 text-sm text-gold">{other.role}</p>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <CTA />
  </main>
  <Footer />
</BaseLayout>
