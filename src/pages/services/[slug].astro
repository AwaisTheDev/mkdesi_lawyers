---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import CTA from "../../components/CTA.astro";
import Icon from "../../components/Icon.astro";
import { getPracticeArea, practiceAreas, site } from "../../data/site";

export function getStaticPaths() {
  return practiceAreas.map((area) => ({
    params: { slug: area.slug },
  }));
}

const { slug } = Astro.params;
const area = getPracticeArea(slug!);
if (!area) {
  throw new Error(`Unknown practice area: ${slug}`);
}

const related = practiceAreas.filter((a) => a.slug !== area.slug).slice(0, 3);
---

<BaseLayout
  title={`${area.title} Lawyers Victoria | ${site.name}`}
  description={area.summary}
>
  <Header />
  <main>
    <section class="relative overflow-hidden bg-navy pt-28 text-white md:pt-32">
      <div class="absolute inset-0">
        <img
          src="/images/inner-banner.webp"
          alt="Makdesi & Associates Lawyers reception"
          class="h-full w-full object-cover object-center"
          width="2400"
          height="1400"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-navy via-navy/85 to-navy/55"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-navy/70 via-transparent to-navy/40"></div>
      </div>
      <div class="relative z-10 mx-auto max-w-7xl px-5 pb-16 md:px-8 md:pb-20">
        <a
          href="/services"
          class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.14em] text-gold no-underline hover:text-gold-bright"
        >
          <span aria-hidden="true">←</span> Areas of Law
        </a>
        <div class="mt-8 flex items-start gap-4">
          <span class="mt-1 flex h-12 w-12 shrink-0 items-center justify-center border border-gold text-gold">
            <Icon name={area.icon} class="h-6 w-6" />
          </span>
          <div>
            <h1 class="font-display text-[clamp(2.2rem,4.5vw,3.6rem)] font-semibold leading-[1.1] tracking-tight">
              {area.title}
            </h1>
            <p class="mt-4 max-w-2xl text-base leading-relaxed text-white/65 md:text-lg">
              {area.summary}
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-white py-14 md:py-20">
      <div class="mx-auto grid max-w-7xl gap-12 px-5 md:grid-cols-12 md:gap-16 md:px-8">
        <div class="md:col-span-7">
          {
            area.body.map((paragraph, i) => (
              <p
                class:list={[
                  "text-base leading-relaxed text-slate md:text-lg",
                  i > 0 && "mt-5",
                ]}
              >
                {paragraph}
              </p>
            ))
          }
          <p class="mt-6 border-l-2 border-gold pl-4 text-sm leading-relaxed text-mist">
            {area.jurisdictionNote}
          </p>
          <div class="mt-10 flex flex-wrap gap-3">
            <a href="/contact" class="btn-gold">Make an enquiry</a>
            <a href={site.phoneHref} class="btn-outline-dark">
              <Icon name="phone" class="h-4 w-4" />
              Call {site.phone}
            </a>
          </div>
        </div>

        <aside class="md:col-span-5">
          <div class="border border-navy/10 bg-cream p-6 md:p-8">
            <p class="text-xs font-bold uppercase tracking-[0.14em] text-gold">
              Speak with our team
            </p>
            <p class="mt-3 text-sm leading-relaxed text-slate">
              Based in Brunswick, we advise clients across Melbourne and
              Victoria on {area.title.toLowerCase()} matters.
            </p>
            <ul class="mt-6 space-y-3 text-sm text-navy">
              <li>
                <a href={site.phoneHref} class="font-semibold no-underline hover:text-gold"
                  >{site.phone}</a
                >
              </li>
              <li>
                <a href={site.emailHref} class="no-underline hover:text-gold"
                  >{site.email}</a
                >
              </li>
              <li class="text-slate">{site.address.full}</li>
            </ul>
            <a href="/contact" class="btn-gold mt-6">Contact us</a>
          </div>
        </aside>
      </div>
    </section>

    {
      area.children?.length ? (
        <section class="border-t border-navy/8 bg-cream py-14 md:py-20">
          <div class="mx-auto max-w-7xl px-5 md:px-8">
            <h2 class="font-display text-3xl font-semibold text-navy md:text-4xl">
              Related services
            </h2>
            <p class="mt-3 max-w-2xl text-base text-slate">
              Explore specific {area.title.toLowerCase()} services we offer in
              Victoria.
            </p>
            <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {area.children.map((child) => (
                <a
                  href={`/services/${area.slug}/${child.slug}`}
                  class="group flex flex-col overflow-hidden border border-navy/10 bg-white no-underline transition-colors hover:border-gold"
                >
                  <div class="aspect-[16/10] overflow-hidden">
                    <img
                      src={child.image}
                      alt={child.title}
                      class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
                      width="800"
                      height="500"
                      loading="lazy"
                    />
                  </div>
                  <div class="flex flex-1 flex-col p-5">
                    <h3 class="font-display text-xl font-semibold text-navy group-hover:text-gold-deep">
                      {child.title}
                    </h3>
                    <p class="mt-2 flex-1 text-sm leading-relaxed text-slate">
                      {child.description}
                    </p>
                    <span class="mt-4 text-[0.72rem] font-bold uppercase tracking-[0.12em] text-gold">
                      Learn more →
                    </span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </section>
      ) : null
    }

    <section class="bg-white py-14 md:py-20">
      <div class="mx-auto max-w-7xl px-5 md:px-8">
        <h2 class="font-display text-3xl font-semibold text-navy">
          Other areas of law
        </h2>
        <div class="mt-8 grid gap-4 sm:grid-cols-3">
          {
            related.map((item) => (
              <a
                href={`/services/${item.slug}`}
                class="group border border-navy/10 bg-cream p-5 no-underline transition-colors hover:border-gold"
              >
                <h3 class="font-display text-xl font-semibold text-navy group-hover:text-gold-deep">
                  {item.title}
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-slate">
                  {item.description}
                </p>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <CTA />
  </main>
  <Footer />
</BaseLayout>
