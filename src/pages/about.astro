---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import PageHero from "../components/PageHero.astro";
import Footer from "../components/Footer.astro";
import CTA from "../components/CTA.astro";
import { about, site, trustItems } from "../data/site";
import Icon from "../components/Icon.astro";
---

<BaseLayout
  title={`About the Firm | ${site.name}`}
  description={about.intro}
>
  <Header />
  <main>
    <PageHero
      eyebrow="About the firm"
      title={about.headline}
      description={about.intro}
    />

    <section class="bg-white py-16 md:py-24">
      <div class="mx-auto grid max-w-7xl gap-12 px-5 md:grid-cols-12 md:gap-16 md:px-8">
        <div class="md:col-span-7">
          {
            about.paragraphs.map((paragraph, i) => (
              <p
                class:list={[
                  "text-base leading-relaxed text-slate md:text-lg",
                  i > 0 && "mt-5",
                ]}
              >
                {paragraph}
              </p>
            ))
          }
          <p class="mt-5 text-base leading-relaxed text-slate md:text-lg">
            Learn more about{" "}
            <a
              href={site.sisterFirm.url}
              class="font-semibold text-gold no-underline hover:text-gold-deep"
              target="_blank"
              rel="noopener noreferrer"
              >{site.sisterFirm.name}</a
            >.
          </p>
        </div>

        <aside class="md:col-span-5">
          <div class="border border-navy/10 bg-cream p-6 md:p-8">
            <p class="text-xs font-bold uppercase tracking-[0.14em] text-gold">
              How we work
            </p>
            <ul class="mt-6 space-y-6">
              {
                about.values.map((value) => (
                  <li>
                    <h2 class="font-display text-xl font-semibold text-navy">
                      {value.title}
                    </h2>
                    <p class="mt-2 text-sm leading-relaxed text-slate">
                      {value.description}
                    </p>
                  </li>
                ))
              }
            </ul>
          </div>
        </aside>
      </div>
    </section>

    <section class="border-y border-navy/8 bg-cream py-14 md:py-16">
      <div class="mx-auto grid max-w-7xl gap-8 px-5 sm:grid-cols-2 lg:grid-cols-4 md:px-8">
        {
          trustItems.map((item) => (
            <div>
              <div class="flex h-11 w-11 items-center justify-center border border-gold text-gold">
                <Icon name={item.icon} class="h-5 w-5" />
              </div>
              <h2 class="mt-4 font-display text-xl font-semibold text-navy">
                {item.title}
              </h2>
              <p class="mt-2 text-sm leading-relaxed text-slate">{item.description}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="bg-white py-16 md:py-20">
      <div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-6 px-5 md:flex-row md:items-center md:px-8">
        <div>
          <h2 class="font-display text-3xl font-semibold text-navy md:text-4xl">
            Meet the people behind the firm
          </h2>
          <p class="mt-3 max-w-xl text-base text-slate">
            Profiles for Mary, Nizar, Clara and Natascia — each on their own page.
          </p>
        </div>
        <a href="/team" class="btn-gold">Our Team</a>
      </div>
    </section>

    <CTA />
  </main>
  <Footer />
</BaseLayout>
