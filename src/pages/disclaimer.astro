---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import PageHero from "../components/PageHero.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";
---

<BaseLayout
  title={`Disclaimer | ${site.name}`}
  description={`Important disclaimer regarding information published by ${site.name}.`}
>
  <Header />
  <main>
    <PageHero
      eyebrow="Legal"
      title="Disclaimer"
      description="Important information about how to use content on this website."
    />

    <section class="bg-white py-16 md:py-24">
      <div class="mx-auto max-w-3xl space-y-8 px-5 text-base leading-relaxed text-slate md:px-8">
        <p class="text-sm text-mist">Last updated: September 2026</p>

        <div>
          <h2 class="font-display text-2xl font-semibold text-navy">General information only</h2>
          <p class="mt-3">
            The material on this website is intended to provide general
            information about {site.name} and the types of matters we may
            assist with. It is not legal advice and should not be relied upon
            as such. Laws change and every matter turns on its own facts.
          </p>
        </div>

        <div>
          <h2 class="font-display text-2xl font-semibold text-navy">No solicitor–client relationship</h2>
          <p class="mt-3">
            Contacting us through this website, by phone or by email does not
            of itself create a solicitor–client relationship. We may decline
            to act where there is a conflict of interest, capacity issue, or
            for any other professional reason. Confidentiality and privilege
            apply once we have formally agreed to act for you, subject to law.
          </p>
        </div>

        <div>
          <h2 class="font-display text-2xl font-semibold text-navy">No guaranteed outcomes</h2>
          <p class="mt-3">
            We do not make unsupported claims about success rates, guaranteed
            results, or superiority over other firms. Any testimonials or
            client reviews published on this site reflect the experience of
            those individuals only and do not predict outcomes in other
            matters.
          </p>
        </div>

        <div>
          <h2 class="font-display text-2xl font-semibold text-navy">Urgent matters</h2>
          <p class="mt-3">
            If you have an urgent legal matter (including police interviews,
            court deadlines or time-critical transactions), contact us
            immediately by phone on{" "}
            <a href={site.phoneHref}>{site.phone}</a>. Do not rely solely on
            a website enquiry form for time-sensitive issues.
          </p>
        </div>

        <div>
          <h2 class="font-display text-2xl font-semibold text-navy">Professional standards</h2>
          <p class="mt-3">
            Liability limited by a scheme approved under Professional Standards
            Legislation. For privacy practices, see our{" "}
            <a href="/privacy" class="text-navy underline hover:text-gold">Privacy Policy</a>.
            For website use, see our{" "}
            <a href="/terms" class="text-navy underline hover:text-gold">Website Terms</a>.
          </p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
