---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import PageHero from "../components/PageHero.astro";
import Footer from "../components/Footer.astro";
import CTA from "../components/CTA.astro";
import Icon from "../components/Icon.astro";
import { site } from "../data/site";
---

<BaseLayout
  title={`Our Location | ${site.name}`}
  description={`Visit Makdesi Lawyers at ${site.address.full}. Call ${site.phone} or email ${site.email}.`}
>
  <Header />
  <main>
    <PageHero
      eyebrow="Our location"
      title="Visit us in Brunswick"
      description="Makdesi And Associates Lawyers — conveniently located on Sydney Road."
    />

    <section class="bg-white py-16 md:py-24">
      <div class="mx-auto grid max-w-7xl gap-12 px-5 md:grid-cols-12 md:gap-16 md:px-8">
        <div class="md:col-span-5">
          <p class="text-xs font-bold uppercase tracking-[0.14em] text-gold">
            Office address
          </p>
          <h2 class="mt-3 font-display text-3xl font-semibold text-navy md:text-4xl">
            {site.name}
          </h2>
          <p class="mt-5 text-lg leading-relaxed text-slate">
            {site.address.line1}<br />
            Brunswick<br />
            VIC 3056
          </p>

          <ul class="mt-10 space-y-5">
            <li class="flex items-start gap-4">
              <span class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center border border-gold text-gold">
                <Icon name="phone" class="h-5 w-5" />
              </span>
              <div>
                <p class="text-xs font-bold uppercase tracking-[0.12em] text-mist">
                  Telephone
                </p>
                <a
                  href={site.phoneHref}
                  class="mt-1 block text-lg text-navy no-underline hover:text-gold"
                  >{site.phone}</a
                >
              </div>
            </li>
            <li class="flex items-start gap-4">
              <span class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center border border-gold text-gold">
                <Icon name="mail" class="h-5 w-5" />
              </span>
              <div>
                <p class="text-xs font-bold uppercase tracking-[0.12em] text-mist">
                  Email
                </p>
                <a
                  href={site.emailHref}
                  class="mt-1 block text-lg text-navy no-underline hover:text-gold"
                  >{site.email}</a
                >
              </div>
            </li>
            <li class="flex items-start gap-4">
              <span class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center border border-gold text-gold">
                <Icon name="mapPin" class="h-5 w-5" />
              </span>
              <div>
                <p class="text-xs font-bold uppercase tracking-[0.12em] text-mist">
                  Address
                </p>
                <a
                  href={site.address.mapsLink}
                  class="mt-1 block text-lg text-navy no-underline hover:text-gold"
                  target="_blank"
                  rel="noopener noreferrer"
                  >{site.address.full}</a
                >
              </div>
            </li>
          </ul>

          <div class="mt-10 flex flex-wrap gap-3">
            <a
              href={site.address.mapsLink}
              class="btn-gold"
              target="_blank"
              rel="noopener noreferrer"
            >
              Open in Google Maps
            </a>
            <a href="/contact" class="btn-outline-dark">Make an enquiry</a>
          </div>
        </div>

        <div class="md:col-span-7">
          <div class="overflow-hidden border border-navy/10">
            <img
              src="/images/office-exterior.webp"
              alt={`Exterior of ${site.name} at ${site.address.full}`}
              class="aspect-[16/10] w-full object-cover"
              width="1200"
              height="750"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>

    <section class="bg-cream py-16 md:py-20">
      <div class="mx-auto max-w-7xl px-5 md:px-8">
        <h2 class="font-display text-3xl font-semibold text-navy md:text-4xl">
          How to find us
        </h2>
        <p class="mt-3 max-w-2xl text-base leading-relaxed text-slate">
          We are located at 705 Sydney Road, Brunswick VIC 3056 — on one of
          Melbourne’s main northern corridors, with public transport and street
          parking nearby.
        </p>
        <div class="mt-8 overflow-hidden border border-navy/10 bg-white">
          <iframe
            title={`Map showing ${site.address.full}`}
            src={site.address.mapsEmbed}
            class="h-[360px] w-full border-0 md:h-[480px]"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen></iframe>
        </div>
      </div>
    </section>

    <CTA />
  </main>
  <Footer />
</BaseLayout>
