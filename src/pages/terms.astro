---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import PageHero from "../components/PageHero.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";
---

<BaseLayout
  title={`Website Terms of Use | ${site.name}`}
  description={`Terms governing use of the ${site.name} website.`}
>
  <Header />
  <main>
    <PageHero
      eyebrow="Legal"
      title="Website Terms of Use"
      description="Please read these terms before using this website."
    />

    <section class="bg-white py-16 md:py-24">
      <div class="mx-auto max-w-3xl space-y-8 px-5 text-base leading-relaxed text-slate md:px-8">
        <p>
          These Website Terms of Use (“Terms”) govern your access to and use of
          the website operated by {site.name} at {site.url.replace("https://", "")}
          and related pages (the “Site”). By using the Site, you agree to these
          Terms. If you do not agree, please do not use the Site.
        </p>
        <p class="text-sm text-mist">Last updated: September 2026</p>

        <div>
          <h2 class="font-display text-2xl font-semibold text-navy">1. About this website</h2>
          <p class="mt-3">
            The Site provides general information about {site.name}, our team,
            practice areas and how to contact us. It is operated from Victoria,
            Australia.
          </p>
        </div>

        <div>
          <h2 class="font-display text-2xl font-semibold text-navy">2. Not legal advice</h2>
          <p class="mt-3">
            Content on this Site is general information only and does not
            constitute legal advice. It should not be relied on as a substitute
            for professional advice tailored to your circumstances. Viewing this
            Site, submitting an enquiry, or contacting us does not create a
            solicitor–client relationship unless and until we expressly agree
            to act for you (usually confirmed in writing, including a costs
            disclosure / engagement letter where required).
          </p>
        </div>

        <div>
          <h2 class="font-display text-2xl font-semibold text-navy">3. No guarantees</h2>
          <p class="mt-3">
            We do not guarantee particular outcomes, timelines or results. Past
            client experiences described in reviews (where published) relate to
            those individuals’ matters only and are not indicative of results in
            other matters.
          </p>
        </div>

        <div>
          <h2 class="font-display text-2xl font-semibold text-navy">4. Accuracy and availability</h2>
          <p class="mt-3">
            We aim to keep information on the Site reasonably accurate and
            up to date, but we do not warrant that it is complete, current or
            free from error. The Site may be unavailable from time to time for
            maintenance or reasons beyond our control.
          </p>
        </div>

        <div>
          <h2 class="font-display text-2xl font-semibold text-navy">5. Intellectual property</h2>
          <p class="mt-3">
            Unless otherwise stated, all content on the Site (including text,
            branding, layout and imagery) is owned by or licensed to
            {site.name}. You may view and print material for personal,
            non-commercial use. You must not copy, reproduce, modify or
            distribute Site content without our prior written consent, except
            as permitted by law.
          </p>
        </div>

        <div>
          <h2 class="font-display text-2xl font-semibold text-navy">6. Acceptable use</h2>
          <p class="mt-3">You must not:</p>
          <ul class="mt-3 list-disc space-y-2 pl-5">
            <li>Use the Site in any way that is unlawful or harmful</li>
            <li>Attempt to gain unauthorised access to the Site or related systems</li>
            <li>Transmit malware, spam or disruptive content</li>
            <li>Scrape or harvest data from the Site without our consent</li>
            <li>Misrepresent your identity when contacting us</li>
          </ul>
        </div>

        <div>
          <h2 class="font-display text-2xl font-semibold text-navy">7. Third-party links</h2>
          <p class="mt-3">
            The Site may link to third-party websites (including our sister firm
            Genuine Legal Group). We are not responsible for the content,
            availability or privacy practices of external sites.
          </p>
        </div>

        <div>
          <h2 class="font-display text-2xl font-semibold text-navy">8. Privacy</h2>
          <p class="mt-3">
            Personal information submitted through the Site is handled in
            accordance with our{" "}
            <a href="/privacy" class="text-navy underline hover:text-gold">Privacy Policy</a>.
          </p>
        </div>

        <div>
          <h2 class="font-display text-2xl font-semibold text-navy">9. Limitation of liability</h2>
          <p class="mt-3">
            To the maximum extent permitted by law (including the Australian
            Consumer Law), we exclude liability for any loss or damage arising
            from your use of, or reliance on, the Site or its content. Where
            liability cannot be excluded, it is limited to the resupply of the
            relevant services or the cost of resupply.
          </p>
          <p class="mt-3">
            Liability limited by a scheme approved under Professional Standards
            Legislation.
          </p>
        </div>

        <div>
          <h2 class="font-display text-2xl font-semibold text-navy">10. Governing law</h2>
          <p class="mt-3">
            These Terms are governed by the laws of Victoria, Australia. You
            submit to the non-exclusive jurisdiction of the courts of Victoria.
          </p>
        </div>

        <div>
          <h2 class="font-display text-2xl font-semibold text-navy">11. Contact</h2>
          <p class="mt-3">
            Questions about these Terms:{" "}
            <a href={site.emailHref}>{site.email}</a> ·{" "}
            <a href={site.phoneHref}>{site.phone}</a>
          </p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
